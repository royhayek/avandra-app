{
  "cli": {
    "version": ">= 0.54.1"
  },
  "build": {
    "development": {
      "channel": "dev",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SERVER_API_URL": "http://localhost:4000/api"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_SERVER_API_URL": "http://localhost:4000/api"
      },
      "channel": "development-simulator"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": true
      },
      "channel": "preview"
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_SERVER_API_URL": "https://trip-ai-server.onrender.com/api"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./trippify-411809-bdd413c2cd28.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "royhayek27@gmail.com",
        "ascAppId": "6476438006",
        "appleTeamId": "DVGN5DN5ST"
      }
    }
  }
}
